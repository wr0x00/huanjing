# 复制为 .env 后按需修改；全部可留空 —— 无任何 Key 时 MVP 自动走离线模板降级
HP_PERSONA=默认仿冒模板
# 靶站入口（生产换域名）；Canary 回连统一走管理端
HP_SITE_PORT=8888
HP_SITE_HOST=0.0.0.0
HP_CONSOLE_PORT=9000
# 管理端默认仅本机访问；企业部署应置于带身份认证的内网反向代理后
HP_CONSOLE_HOST=127.0.0.1
HP_CALLBACK_BASE=http://127.0.0.1:9000
HP_GROWTH_QUOTA=20
# 浏览器 WebRTC 会访问外部 STUN；默认关闭，只有明确批准出口流量后才开启
HP_WEBRTC_ATTRIBUTION=false

# 存储：按职责拆成 5 个库（站点信息 / 运行日志 / 会话画像 / 配置 / 资产）
# HP_DB_DIR 指定这 5 个库文件所在目录；不填则沿用旧单库 honeypot.db 所在目录
# HP_DB_PATH 仍可用，指向旧单库，仅作为一次性迁移来源
# HP_DB_DIR=

# 本地模型（OpenAI 兼容协议，如 vLLM / Ollama）
HP_LOCAL_LLM_URL=http://127.0.0.1:8000/v1
HP_LOCAL_LLM_MODEL=Qwen2.5-14B-Instruct
HP_LOCAL_LLM_KEY=EMPTY

# 云端 Key（任配其一即可）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
